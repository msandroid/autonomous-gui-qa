[
  {
    "type": "function",
    "function": {
      "name": "run_autonomous_exploration",
      "description": "Runs an autonomous Mobile GUI Agent to achieve a natural language goal on iOS/Android.",
      "parameters": {
        "type": "object",
        "properties": {
          "goal": {
            "type": "string",
            "description": "Goal for the agent (e.g. Change target language to Spanish)"
          },
          "platform": {
            "type": "string",
            "enum": [
              "ios",
              "android"
            ],
            "default": "ios"
          },
          "bundle_id": {
            "type": "string",
            "description": "App bundle ID (e.g. Translate.Blue)"
          },
          "max_steps": {
            "type": "integer",
            "default": 10
          }
        },
        "required": [
          "goal"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "run_scenario",
      "description": "Executes a declarative YAML test scenario and generates a visual QA report.",
      "parameters": {
        "type": "object",
        "properties": {
          "scenario_file": {
            "type": "string",
            "description": "Path to the scenario YAML file"
          },
          "platform": {
            "type": "string",
            "enum": [
              "ios",
              "android"
            ],
            "default": "ios"
          },
          "output_dir": {
            "type": "string",
            "default": "reports"
          }
        },
        "required": [
          "scenario_file"
        ]
      }
    }
  },
  {
